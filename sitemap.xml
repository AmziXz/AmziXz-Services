---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for page_lang in site.data.languages %}
  <url>
    <loc>{{ site.origin }}{{ page_lang.path }}</loc>
    <lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod>
{%- for l in site.data.languages %}
    <xhtml:link rel="alternate" hreflang="{{ l.code }}" href="{{ site.origin }}{{ l.path }}" />
{%- endfor %}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.origin }}{{ site.data.languages.first.path }}" />
  </url>
{%- endfor %}
</urlset>
